<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Casa Oro Del Toro Restaurant</title>

<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">

<style>
body {
  margin: 0;
  background: #0B0B0B;
  color: #F5F5F5;
  font-family: 'Poppins', sans-serif;
}

/* NAV */
nav {
  display: flex;
  justify-content: space-between;
  padding: 20px 40px;
  border-bottom: 1px solid rgba(212,175,55,0.2);
}

.logo {
  font-family: 'Cinzel', serif;
  color: #D4AF37;
  font-size: 22px;
  letter-spacing: 2px;
}

.nav-sub {
  font-size: 12px;
  color: #8B0000;
}

/* HERO */
.hero {
  height: 90vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 40px;
  position: relative;
  overflow: hidden;
}

.hero h1 {
  font-family: 'Cinzel', serif;
  font-size: 52px;
  color: #D4AF37;
  text-shadow: 0 0 20px rgba(212,175,55,0.5);
}

.hero p {
  max-width: 600px;
  font-size: 18px;
  margin-top: 10px;
}

.tagline {
  margin-top: 20px;
  color: #8B0000;
  font-weight: bold;
}

/* EMBERS */
.ember {
  position: absolute;
  width: 5px;
  height: 5px;
  background: #D4AF37;
  border-radius: 50%;
  animation: float 5s infinite ease-in;
}

@keyframes float {
  0% { transform: translateY(0); opacity: 1; }
  100% { transform: translateY(-800px); opacity: 0; }
}

/* SECTIONS */
section {
  padding: 80px 40px;
}

h2 {
  font-family: 'Cinzel', serif;
  color: #D4AF37;
  margin-bottom: 20px;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px,1fr));
  gap: 20px;
}

.menu-item {
  border: 1px solid rgba(212,175,55,0.2);
  padding: 20px;
  transition: 0.3s;
}

.menu-item:hover {
  border-color: #D4AF37;
  transform: translateY(-5px);
}

/* STRIP */
.strip {
  background: #8B0000;
  text-align: center;
  padding: 20px;
  font-weight: bold;
}

/* EVENTS */
.event {
  margin-bottom: 10px;
}

/* BUTTON */
button {
  background: #D4AF37;
  color: #0B0B0B;
  border: none;
  padding: 12px 24px;
  cursor: pointer;
  font-weight: bold;
}

button:hover {
  background: #b8962e;
}

/* FOOTER */
footer {
  border-top: 1px solid rgba(212,175,55,0.2);
  padding: 40px;
  text-align: center;
  font-size: 14px;
}
</style>
</head>

<body>

<nav>
  <div>
    <div class="logo">CASA ORO DEL TORO</div>
    <div class="nav-sub">Zacatecas, México</div>
  </div>
</nav>

<div class="hero">
  <h1>Casa Oro Del Toro Restaurant</h1>
  <p>De Nuestra Tierra Nace El Sabor, Donde El Toro Define El Sabor</p>
  <div class="tagline">Zacatecas, México</div>

  <!-- Embers -->
  <div class="ember" style="left:10%; animation-delay:0s;"></div>
  <div class="ember" style="left:30%; animation-delay:1s;"></div>
  <div class="ember" style="left:50%; animation-delay:2s;"></div>
  <div class="ember" style="left:70%; animation-delay:3s;"></div>
  <div class="ember" style="left:90%; animation-delay:4s;"></div>
</div>

<div class="strip">
  De Nuestra Tierra Nace El Sabor, Donde El Toro Define El Sabor
</div>

<section>
  <h2>About</h2>
  <p>
    Inspired by the roots of Zacatecas, Casa Oro Del Toro brings authentic birria,
    fire-cooked meats, and handmade traditions into a modern cantina experience.
  </p>
</section>

<section>
  <h2>Menu</h2>
  <div class="menu-grid">

    <div class="menu-item">QuesaBirrias</div>
    <div class="menu-item">Birria Pizza</div>
    <div class="menu-item">Hot Cheeto Birria Balls</div>
    <div class="menu-item">Handmade Tortillas</div>

    <div class="menu-item">Street Tacos (Steak, Pork, Chicken, Birria)</div>
    <div class="menu-item">Burritos</div>
    <div class="menu-item">Quesadillas</div>

  </div>
</section>

<section>
  <h2>Events</h2>
  <div class="event">🎺 Banda Night Fridays</div>
  <div class="event">🌙 Velada Ambiental Wednesdays</div>
</section>

<section>
  <h2>Merch</h2>
  <p>Represent Casa Oro Del Toro.</p>
  <button>Coming Soon</button>
</section>

<footer>
  <p>Casa Oro Del Toro Restaurant</p>
  <p>Zacatecas, México</p>
</footer>

</body>
</html>
