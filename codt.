<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Casa Oro Del Toro</title>
  
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">

  <!-- Favicon -->
  <link rel="icon" href="favicon.png" type="image/png">

  <style>
    /* ===== Global Styles ===== */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Roboto', sans-serif;
      background-color: #fff8f0;
      color: #333;
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    img {
      max-width: 100%;
      display: block;
    }

    /* ===== Header ===== */
    header {
      position: fixed;
      width: 100%;
      top: 0;
      left: 0;
      background: rgba(255, 248, 240, 0.95);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 2rem;
      z-index: 1000;
      border-bottom: 2px solid #d49b3d;
    }

    header .logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.8rem;
      font-weight: 700;
      color: #d49b3d;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 2rem;
    }

    nav ul li a {
      font-weight: 500;
      color: #333;
      transition: color 0.3s;
    }

    nav ul li a:hover {
      color: #d49b3d;
    }

    /* ===== Hero Section ===== */
    .hero {
      height: 100vh;
      background: url('hero-bg.jpg') center/cover no-repeat;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: white;
      position: relative;
    }

    .hero::after {
      content: '';
      position: absolute;
      top:0; left:0;
      width:100%; height:100%;
      background: rgba(0,0,0,0.4);
    }

    .hero-content {
      position: relative;
      z-index: 2;
    }

    .hero-content h1 {
      font-family: 'Playfair Display', serif;
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    .hero-content p {
      font-size: 1.2rem;
      margin-bottom: 2rem;
    }

    .hero-content a {
      background-color: #d49b3d;
      color: white;
      padding: 0.8rem 2rem;
      border-radius: 50px;
      font-weight: 500;
      transition: 0.3s;
    }

    .hero-content a:hover {
      background-color: #b37a2d;
    }

    /* ===== Sections ===== */
    section {
      padding: 6rem 2rem;
      max-width: 1200px;
      margin: auto;
    }

    section h2 {
      font-family: 'Playfair Display', serif;
      font-size: 2.5rem;
      color: #d49b3d;
      text-align: center;
      margin-bottom: 2rem;
    }

    /* ===== About ===== */
    .about {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
      align-items: center;
      justify-content: center;
    }

    .about img {
      flex: 1 1 400px;
      border-radius: 15px;
    }

    .about-text {
      flex: 1 1 400px;
    }

    /* ===== Menu ===== */
    .menu-items {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
    }

    .menu-card {
      background-color: #fff4e0;
      padding: 1.5rem;
      border-radius: 10px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
      text-align: center;
      transition: transform 0.3s;
    }

    .menu-card:hover {
      transform: translateY(-5px);
    }

    .menu-card h3 {
      margin-bottom: 0.5rem;
      color: #d49b3d;
    }

    .menu-card p {
      font-size: 0.95rem;
      color: #555;
    }

    /* ===== Gallery ===== */
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1rem;
    }

    /* ===== Contact ===== */
    .contact-form {
      max-width: 600px;
      margin: auto;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .contact-form input,
    .contact-form textarea {
      padding: 1rem;
      border-radius: 8px;
      border: 1px solid #ccc;
      font-size: 1rem;
      width: 100%;
    }

    .contact-form button {
      padding: 1rem;
      border-radius: 50px;
      border: none;
      background-color: #d49b3d;
      color: white;
      font-size: 1rem;
      cursor: pointer;
      transition: 0.3s;
    }

    .contact-form button:hover {
      background-color: #b37a2d;
    }

    /* ===== Footer ===== */
    footer {
      text-align: center;
      padding: 2rem;
      background-color: #333;
      color: white;
    }

    /* ===== Responsive ===== */
    @media(max-width:768px){
      header {
        flex-direction: column;
        gap: 1rem;
      }

      .about {
        flex-direction: column;
      }
    }

  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div class="logo">Casa Oro Del Toro</div>
    <nav>
      <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#menu">Menu</a></li>
        <li><a href="#gallery">Gallery</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <!-- Hero -->
  <section class="hero" id="home">
    <div class="hero-content">
      <h1>El Sabor de Nuestra Tierra</h1>
      <p>Experience authentic Mexican flavors in the heart of Tulsa</p>
      <a href="#menu">View Menu</a>
    </div>
  </section>

  <!-- About -->
  <section id="about">
    <h2>About Us</h2>
    <div class="about">
      <img src="restaurant-interior.jpg" alt="Restaurant Interior">
      <div class="about-text">
        <p>Casa Oro Del Toro brings the traditional flavors of Nochistlán, Mexico to Tulsa. From our birria specialties to our handcrafted cocktails, every dish is a celebration of Mexican culture.</p>
      </div>
    </div>
  </section>

  <!-- Menu -->
  <section id="menu">
    <h2>Our Menu</h2>
    <div class="menu-items">
      <div class="menu-card">
        <h3>Birria Tacos</h3>
        <p>Juicy beef birria tacos served with consommé and fresh salsa.</p>
      </div>
      <div class="menu-card">
        <h3>Cantarito Cocktail</h3>
        <p>Traditional citrus cocktail served in a clay cup for authentic flavor.</p>
      </div>
      <div class="menu-card">
        <h3>Quesabirria</h3>
        <p>Crispy cheese-filled birria tacos, perfect with dipping sauce.</p>
      </div>
      <div class="menu-card">
        <h3>Churros</h3>
        <p>Classic Mexican dessert with cinnamon sugar and chocolate dip.</p>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section id="gallery">
    <h2>Gallery</h2>
    <div class="gallery">
      <img src="gallery1.jpg" alt="Dish 1">
      <img src="gallery2.jpg" alt="Dish 2">
      <img src="gallery3.jpg" alt="Restaurant Interior">
      <img src="gallery4.jpg" alt="Bar Area">
    </div>
  </section>

  <!-- Contact -->
  <section id="contact">
    <h2>Contact Us</h2>
    <form class="contact-form">
      <input type="text" placeholder="Your Name" required>
      <input type="email" placeholder="Your Email" required>
      <textarea rows="5" placeholder="Your Message" required></textarea>
      <button type="submit">Send Message</button>
    </form>
  </section>

  <!-- Footer -->
  <footer>
    &copy; 2026 Casa Oro Del Toro Restaurant & Cantina. All rights reserved.
  </footer>

</body>
</html>
